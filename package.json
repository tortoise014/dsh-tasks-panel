{
  "name": "dsh-tasks-panel",
  "version": "0.5.1",
  "description": "A sidebar Tasks panel for DeepSeek Harness: to-dos with clock times, Feishu reminders on your phone, and a calendar of what you finished each day.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "todo",
    "tasks",
    "calendar",
    "reminders",
    "feishu"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortoise014/dsh-tasks-panel.git"
  },
  "homepage": "https://github.com/tortoise014/dsh-tasks-panel#readme",
  "bugs": {
    "url": "https://github.com/tortoise014/dsh-tasks-panel/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/host.mjs && node test/reminders.mjs && node test/ui.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT"
}
